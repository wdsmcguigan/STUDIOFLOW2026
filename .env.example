NEXT_PUBLIC_SUPABASE_URL=
# The clients read NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (Supabase's newer name,
# set by the Supabase Vercel integration), falling back to the legacy
# NEXT_PUBLIC_SUPABASE_ANON_KEY (used by local `supabase status` / CI). Set either.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/test only — never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# AI breakdown (Phase 2) — Google AI Studio key. Server/test only.
# Tests use a mock model and do NOT need this. Live AI runs do.
GOOGLE_GENERATIVE_AI_API_KEY=
